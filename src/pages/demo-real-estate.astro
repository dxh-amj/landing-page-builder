---
import "../styles/global.css";
import { CenteredNavHeader } from "../components/common/header/index";
import { SplitHero } from "../components/common/hero/index";
import StandardContact, { type ContactInfoItem } from "../components/common/contact/StandardContact";
import { EmailIcon, PhoneIcon, OfficeIcon, DirectionIcon } from "../components/common/icons";
import { ImageCta } from "../components/common/cta/index";
import {CenterTestimonial} from "../components/common/testimonial/index";

const testimonialData = [
  {
    id: 1,
    name: "Abdur Rahim",
    role: "Founder, TechStart Bangladesh",
    content: "They understood our business from day one and delivered exactly what we needed, on time and on budget.",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=abdur", // Placeholder image based on name context
  },
  {
    id: 2,
    name: "Mahdi Hassan",
    role: "CEO, Digital Solutions Ltd",
    content: "The team brought fresh thinking to problems we'd been wrestling with for months. Real partners, not just vendors.",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=mahdi", // Placeholder image based on name context
  },
  {
    id: 3,
    name: "Amina Hossain",
    role: "Operations Director, Growth Ventures",
    content: "Professional, responsive, and genuinely invested in our success. They made the whole process feel effortless.",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=amina", // Placeholder image based on name context
  },
  {
    id: 4,
    name: "Rahim Ahmed",
    role: "Regular customer",
    content: "“Best food in town! Fresh, tasty, and fast service.”",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=rahim", // Placeholder based on name context
  },
  {
    id: 5,
    name: "Fatima Khan",
    role: "Food enthusiast",
    content: "“The flavors are authentic and the portions are generous. Highly recommended.”",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=fatima", // Placeholder based on name context
  },
  {
    id: 6,
    name: "Karim Hassan",
    role: "Loyal customer",
    content: "“Excellent service and delicious meals. This is my favorite place to eat.”",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=karim", // Placeholder based on name context
  }
];

const contactItems: ContactInfoItem[] = [
  {
    icon: EmailIcon,
    title: "Email",
    description: "Send us a message",
    action: {
      label: "hello@realestate.com",
      href: "mailto:hello@realestate.com",
      type: "link"
    }
  },
  {
    icon: PhoneIcon,
    title: "Phone",
    description: "Call us anytime",
    action: {
      label: "+61 2 9000 0000",
      href: "tel:+61290000000",
      type: "link"
    }
  },
  {
    icon: OfficeIcon,
    title: "Office",
    description: "123 Main Street, Dhaka 1205, Bangladesh",
    action: {
      label: "Get Directions",
      href: "#",
      type: "button",
      icon: DirectionIcon
    }
  }
];

const headingStyle = {
  fontSize: "var(--Text-Sizes-Heading-3, 48px)",
  fontWeight: 600,
  lineHeight: "120%",
  letterSpacing: "-0.48px",
  color: "var(--Background-background-500, #FFF)",
};

const bodyStyle = {
  fontSize: "18px",
  fontWeight: 400,
  lineHeight: "150%",
  color: "var(--Background-background-500, #FFF)",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Real Estate Landing Page Demo" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Real Estate Design Demo</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display+SC:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0A0A0A] font-inter">
    <CenteredNavHeader
      client:load
      brandName="BUILDERS"
      brandFont='"Playfair Display SC", serif'
      primaryColor="#059669"
      navItems={[
        { label: "Properties", href: "#" },
        { label: "About Us", href: "#" },
        { label: "Testimonials", href: "#" },
        { label: "Contact", href: "#" }
      ]}
      textColor="#FFFFFF"
      bgColor="bg-[#0A0A0A]/90"
      borderColor="border-white/10"
      brandWeight={700}
      buttonRadius="12px"
    />
    <SplitHero
      heading="Find the perfect property with confidence"
      body="We help buyers and investors find the best properties with expert guidance. Our transparent process makes every step simple and secure."
      primaryColor="#059669"
      headingStyle={headingStyle}
      bodyStyle={bodyStyle}
      bgClassName="bg-[#0A0A0A]"
      sideImage="/images/real_estate_hero.png"
      imageAlt="Luxury Estate"
      primaryCtaText="Schedule a Viewing"
      secondaryCtaText="Learn More"
      showDecorativeElements={true}
      showDecorativeElements={true}
      buttonRadius="12px"
    />

    <CenterTestimonial 
      client:visible
      topHeader="Testimonials"
      topHeaderBg="bg-linear-to-r from-[#B1FFE7] to-[#80FFD7]"
      heading="Client stories"
      subheading="Real experiences from people who found their perfect property."
      testimonials={testimonialData}
      primaryColor="#1E4ED8"
      backgroundColor="#FFFFFF"
    />
    <ImageCta
      title="Ready to find your property"
      description="Schedule a free consultation with our team and take the first step toward your next investment."
      primaryActionText="Consult Us"
      secondaryActionText="Learn More"
      imageUrl="/images/cta/product_bg.png"
      primaryColor="#059669"
      buttonRadius="12px"
    />
    <StandardContact
      tagline="Connect"
      heading="Get in touch"
      description="Have questions about our properties or services? We're here to help."
      imageSrc="https://api.builder.io/api/v1/image/assets/TEMP/b4d9047ef5262741e8adacfeb08d35c5a677520b?width=1600"
      primaryColor="#059669"
      buttonRadius="12px"
      taglineBackgroundColor="#D1FAE5"
      contactInfo={contactItems}
    />
  </body>
</html>
