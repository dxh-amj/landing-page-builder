---
import "../styles/global.css";
import { StandardHeader } from "../components/common/header/index";
import { CenteredHero } from "../components/common/hero/index";
import { SplitCta } from "../components/common/cta/index";
import FeatureShowcase from "../components/common/features/FeatureShowcase";
import ProvenResults from "../components/designs/business/ProvenResults";
import StatsSection from "../components/designs/business/StatsSection";

const businessFeatures = [
  {
    title: "Strategy consulting",
    description: "We map your market, define your positioning, and chart the path forward.",
    imageSrc: "/images/features/strategy.jpg",
    badgeText: "Strategy",
    buttonText: "Learn more",
    layout: "vertical" as const,
  },
  {
    title: "Product design",
    description: "Beautiful interfaces that work hard and feel right for your users.",
    imageSrc: "/images/features/design.jpg",
    badgeText: "Design",
    buttonText: "Explore",
    layout: "horizontal" as const,
  },
  {
    title: "Team augmentation",
    description: "Skilled engineers who integrate seamlessly into your existing teams.",
    imageSrc: "/images/features/engineering.jpg",
    badgeText: "Engineering",
    buttonText: "Explore",
    layout: "horizontal" as const,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Business Landing Page Demo" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Business Design Demo</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sedan+SC&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-inter">
    <StandardHeader
      client:load
      brandName="Truston"
      brandFont='"Sedan SC", serif'
      primaryColor="#2563EB"
      navItems={["Services", "About", "Work"]}
      showLogin={true}
      buttonRadius="8px"
    />
    <CenteredHero
      heading="Powering Businesses With Intelligent Digital Solutions"
      body="From strategy to execution, we design and build technology that drives growth, efficiency, and long-term success."
      primaryColor="#2563EB"
      backgroundImage="/images/business-hero-image.png"
      primaryCtaText="Get Started"
      secondaryCtaText="Learn more"
      buttonRadius="8px"
    />
    <FeatureShowcase
      tagline="Capabilities"
      heading="What we do best"
      description="We combine strategic thinking with hands-on execution to deliver results."
      primaryColor="#1E4ED8"
      backgroundColor="#E9EDFB"
      buttonRadius="8px"
      badgeBackground="#1E4ED8"
      badgeTextColor="#FFFFFF"
      features={businessFeatures}
    />
    <ProvenResults
      primaryColor="#1E4ED8"
      backgroundColor="#FFFFFF"
    />
    <StatsSection
      primaryColor="#1E4ED8"
      backgroundColor="#E9EDFB"
    />
    <SplitCta
      title="Let's Turn Your Ideas Into Results"
      description="Talk to our experts and discover how we can support your goals with proven strategies and modern solutions."
      primaryActionText="Get Started"
      secondaryActionText="View Services"
      imageUrl="/images/cta/business_bg.png"
      imageAlt="Business transformation"
      primaryColor="#1E4ED8"
      backgroundColor="#E9EDFB"
      buttonRadius="8px"
    />
  </body>
</html>
