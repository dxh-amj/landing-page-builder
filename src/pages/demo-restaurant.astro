---
import "../styles/global.css";
import { CenteredNavHeader } from "../components/common/header/index";
import RestaurantHero from "../components/designs/restaurant/RestaurantHero";
import StandardContact, { type ContactInfoItem } from "../components/common/contact/StandardContact";
import { EmailIcon, PhoneIcon, OfficeIcon, DirectionIcon } from "../components/common/icons";
import { ImageCta } from "../components/common/cta/index";
import {StandardTestimonial} from "../components/common/testimonial/index";

const testimonialData = [
  {
    id: 1,
    name: "Abdur Rahim",
    role: "Founder, TechStart Bangladesh",
    content: "They understood our business from day one and delivered exactly what we needed, on time and on budget.",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=abdur", // Placeholder image based on name context
  },
  {
    id: 2,
    name: "Mahdi Hassan",
    role: "CEO, Digital Solutions Ltd",
    content: "The team brought fresh thinking to problems we'd been wrestling with for months. Real partners, not just vendors.",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=mahdi", // Placeholder image based on name context
  },
  {
    id: 3,
    name: "Amina Hossain",
    role: "Operations Director, Growth Ventures",
    content: "Professional, responsive, and genuinely invested in our success. They made the whole process feel effortless.",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=amina", // Placeholder image based on name context
  },
  {
    id: 4,
    name: "Rahim Ahmed",
    role: "Regular customer",
    content: "“Best food in town! Fresh, tasty, and fast service.”",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=rahim", // Placeholder based on name context
  },
  {
    id: 5,
    name: "Fatima Khan",
    role: "Food enthusiast",
    content: "“The flavors are authentic and the portions are generous. Highly recommended.”",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=fatima", // Placeholder based on name context
  },
  {
    id: 6,
    name: "Karim Hassan",
    role: "Loyal customer",
    content: "“Excellent service and delicious meals. This is my favorite place to eat.”",
    rating: 5,
    image: "https://i.pravatar.cc/150?u=karim", // Placeholder based on name context
  }
];

const contactItems: ContactInfoItem[] = [
  {
    icon: EmailIcon,
    title: "Email",
    description: "Send us a message",
    action: {
      label: "hello@restaurant.com",
      href: "mailto:hello@restaurant.com",
      type: "link"
    }
  },
  {
    icon: PhoneIcon,
    title: "Phone",
    description: "Call us during business hours",
    action: {
      label: "+880 13091 52407",
      href: "tel:+8801309152407",
      type: "link"
    }
  },
  {
    icon: OfficeIcon,
    title: "Office",
    description: "123 Main Street, Dhaka 1205, Bangladesh",
    action: {
      label: "Get Direction",
      href: "#",
      type: "button",
      icon: DirectionIcon
    }
  }
];

const brandFont = "cursive"; // Placeholder, will set styling in component prop if needed or load font
// This is a refined demo page for the restaurant template.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Restaurant Landing Page Demo" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Deshi Delights - Restaurant Demo</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Playwrite+US+Trad:wght@100..400&family=Poppins:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white font-poppins">
    <CenteredNavHeader
      client:load
      brandName="Deshi Delights"
      brandFont='"Playwrite US Trad", cursive'
      primaryColor="#EA580C"
      navItems={[
        { label: "Menu", href: "#" },
        { label: "About", href: "#" },
        { label: "Reviews", href: "#" },
        { label: "Reservations", href: "#" },
      ]}
      navFont='"Poppins", sans-serif'
      buttonRadius="100px"
    />
    <RestaurantHero client:load buttonRadius="100px" />
      <ImageCta
      title="Ready to taste something real?"
      description="Join us for a meal that matters, made the way it should be."
      primaryActionText="Book a Table"
      secondaryActionText="View Menu"
      imageUrl="/images/cta/restaurant_bg.jpg"
      primaryColor="#EA580C"
      secondaryColor="#EA580C"
      buttonRadius="100px"
    />
    <StandardTestimonial 
      client:visible
      heading="Customer testimonials"
      subheading="See what our guests have to say about their dining experience with us."
      testimonials={testimonialData}
      primaryColor="#1E4ED8"
      backgroundColor="#FFFFFF"
    />
    <StandardContact
      tagline="Reach us"
      heading="Get in touch"
      description="We're here to answer your questions and take your order anytime."
      imageSrc="https://api.builder.io/api/v1/image/assets/TEMP/b4d9047ef5262741e8adacfeb08d35c5a677520b?width=1600"
      primaryColor="#EA580C"
      buttonRadius="100px"
      contactInfo={contactItems}
    />
  
  </body>
</html>
