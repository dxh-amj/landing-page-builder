---
import Layout from "../layouts/Layout.astro";

const designs = [
  {
    title: "Real Estate Design",
    description: "Modern, high-contrast dark theme for luxury properties and builders.",
    href: "/demo-real-estate",
    color: "from-emerald-500 to-emerald-700",
    tags: ["Dark Mode", "Luxury", "Responsive"],
    image: "/images/real_estate_hero.png"
  },
  {
    title: "Business Design",
    description: "Professional and trust-focused landing page for corporate services.",
    href: "/demo-business",
    color: "from-blue-500 to-blue-700",
    tags: ["Clean", "Corporate", "Interactive"],
    image: "/images/business-hero-image.png"
  },
  {
    title: "Ecommerce",
    description: "Clean, product-focused layout with standardized header and split hero",
    href: "/demo-ecommerce",
    color: "bg-purple-50 hover:border-purple-200",
    tags: ["Light Mode", "Product", "Conversion"],
    image: "/images/ecommerce-hero.png"
  },
  {
    title: "Education",
    description: "Modern learning platform with transparent-to-solid header effect",
    href: "/demo-education",
    color: "bg-indigo-50 hover:border-indigo-200",
    tags: ["Dark Mode", "Education", "Transparent Header"],
    image: "/images/education-hero.jpg"
  },
  {
    title: "Restaurant",
    description: "Appetizing layout with scrolling food gallery and centered navigation",
    href: "/demo-restaurant",
    color: "bg-orange-50 hover:border-orange-200",
    tags: ["Food", "Grid Animation", "Centered Nav"],
    image: "https://api.builder.io/api/v1/image/assets/TEMP/31f7b0335315b43417be17e3fa536df0e92c6458"
  },
];
---

<Layout title="Design Catalog | Page Builder">
  <main class="min-h-screen bg-[#0A0A0A] text-white selection:bg-emerald-500/30">
    <!-- Hero Section -->
    <section class="relative py-24 overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-gradient-to-b from-emerald-500/10 to-transparent blur-[120px] pointer-events-none"></div>
      
      <div class="container mx-auto px-6 relative">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-8 bg-clip-text text-transparent bg-gradient-to-b from-white to-white/50">
            Professional Landing Page Designs
          </h1>
          <p class="text-xl text-zinc-400 mb-12 leading-relaxed">
            A collection of high-performance, responsive designs built with Astro and React. 
            Choose a theme below to preview the layout and interactions.
          </p>
        </div>
      </div>
    </section>

    <!-- Design Grid -->
    <section class="pb-32">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          {designs.map((design) => (
            <a 
              href={design.href}
              class="group relative block bg-zinc-900/50 border border-white/5 rounded-[2rem] overflow-hidden hover:border-white/10 transition-all duration-500 hover:shadow-[0_0_80px_-20px_rgba(16,185,129,0.1)]"
            >
              <!-- Thumbnail -->
              <div class="aspect-[16/10] overflow-hidden grayscale group-hover:grayscale-0 transition-all duration-700">
                <img 
                  src={design.image} 
                  alt={design.title}
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                />
              </div>

              <!-- Content -->
              <div class="p-8">
                <div class="flex flex-wrap gap-2 mb-4">
                  {design.tags.map(tag => (
                    <span class="text-[10px] uppercase tracking-widest font-bold px-2.5 py-1 rounded-full bg-white/5 text-zinc-400 border border-white/5">
                      {tag}
                    </span>
                  ))}
                </div>
                
                <h2 class="text-2xl font-bold mb-3 group-hover:text-emerald-400 transition-colors">
                  {design.title}
                </h2>
                <p class="text-zinc-400 leading-relaxed mb-6">
                  {design.description}
                </p>

                <div class="flex items-center text-sm font-semibold text-emerald-400 group-hover:translate-x-1 transition-transform">
                  Preview Design
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 border-t border-white/5 text-center text-zinc-500 text-sm">
      <p>&copy; 2026 Page Builder Designs. All rights reserved.</p>
    </footer>
  </main>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
  
  body {
    font-family: 'Inter', sans-serif;
    background-color: #0A0A0A;
  }
</style>
