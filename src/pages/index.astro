---
import "../styles/global.css";

const demos = [
  { name: "Business", href: "/demo-business", color: "bg-blue-500" },
  { name: "Education", href: "/demo-education", color: "bg-indigo-500" },
  { name: "Ecommerce", href: "/demo-ecommerce", color: "bg-violet-500" },
  { name: "Real Estate", href: "/demo-real-estate", color: "bg-emerald-500" },
  { name: "Restaurant", href: "/demo-restaurant", color: "bg-orange-500" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Landing Page Builder</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-zinc-950 text-white font-inter min-h-screen flex items-center justify-center">
    <main class="w-full max-w-md px-6 py-12 text-center">
      <h1 class="text-3xl font-bold mb-2">Landing Page Demos</h1>
      <p class="text-zinc-400 mb-8">Select a template to preview</p>

      <div class="flex flex-col gap-3">
        {demos.map((demo) => (
          <a
            href={demo.href}
            class="flex items-center gap-4 px-5 py-4 bg-zinc-900 rounded-xl border border-zinc-800 hover:border-zinc-600 transition-colors"
          >
            <span class={`w-3 h-3 rounded-full ${demo.color}`}></span>
            <span class="font-medium">{demo.name}</span>
            <svg class="w-4 h-4 ml-auto text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>

      <p class="text-zinc-600 text-sm mt-8">Built with Astro + React</p>
    </main>
  </body>
</html>
