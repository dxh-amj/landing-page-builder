---
import "../styles/global.css";
import { StandardHeader } from "../components/common/header/index";
import { CenteredHero } from "../components/common/hero/index";
import StandardContact, { type ContactInfoItem } from "../components/common/contact/StandardContact";
import { EmailIcon, PhoneIcon, OfficeIcon, DirectionIcon } from "../components/common/icons";
import { SplitCta } from "../components/common/cta/index";

const contactItems: ContactInfoItem[] = [
  {
    icon: EmailIcon,
    title: "Email",
    description: "Send us a message",
    action: {
      label: "hello@education.com",
      href: "mailto:hello@education.com",
      type: "link"
    }
  },
  {
    icon: PhoneIcon,
    title: "Phone",
    description: "Call us anytime",
    action: {
      label: "+61 2 9000 0000",
      href: "tel:+61290000000",
      type: "link"
    }
  },
  {
    icon: OfficeIcon,
    title: "Office",
    description: "123 Main Street, Dhaka 1205, Bangladesh",
    action: {
      label: "Get Directions",
      href: "#",
      type: "button",
      icon: DirectionIcon
    }
  }
];

const educationHeading = "Build skills that move your career forward";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Education Landing Page Demo" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Education Design Demo</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#111827] font-inter">
    <StandardHeader
      client:load
      brandName="Education"
      brandFont='"Outfit", sans-serif'
      primaryColor="#4F46E5"
      navItems={["Courses", "Curriculum", "Success Stories", "More"]}
      textColor="#FFFFFF"
      bgColor="bg-[#111827]"
      borderColor="border-gray-800"
      brandWeight={700}
      isTransparentInitially={true}
      ctaText="Enroll Now"
      showLogin={true}
      buttonRadius="16px"
    />
    <CenteredHero
      heading={educationHeading}
      body="Industry-focused training designed to help you succeed in real-world jobs. Learn from experts and join thousands of professionals who transformed their careers."
      primaryColor="#4F46E5"
      backgroundImage="/images/education-hero.jpg"
      headingClassName="text-[42px] md:text-[64px] font-bold leading-[1.1] text-white mb-6"
      bodyClassName="text-[18px] md:text-[20px] font-normal leading-[1.6] text-gray-200 mb-10 max-w-2xl mx-auto"
      primaryCtaText="Enroll Now"
      secondaryCtaText="View Curriculum"
      buttonRadius="16px"
    />
    <StandardContact
      tagline="Connect"
      heading="Get in touch"
      description="Have questions about our properties or services? We're here to help."
      imageSrc="https://api.builder.io/api/v1/image/assets/TEMP/b4d9047ef5262741e8adacfeb08d35c5a677520b?width=1600"
      primaryColor="#0A0A0A"
      taglineBackgroundColor="#8B5CF6"
      taglineTextColor="#FFFFFF"
      sectionClassName="bg-[#EEF2FF]"
      buttonRadius="16px"
      contactInfo={contactItems}
    />
    <SplitCta
      title="Ready to transform your career"
      description="Join thousands who've already taken the first step toward their goals."
      primaryActionText="Get Started"
      secondaryActionText="View Curriculum"
      imageUrl="/images/cta/product_bg.png"
      imageAlt="Education transformation"
      primaryColor="#4F46E5"
      backgroundColor="#EEF2FF"
      buttonRadius="16px"
    />
  </body>
</html>
